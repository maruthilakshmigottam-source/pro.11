#include <stdio.h>
#define INF 999
int main() {
int n;
if (scanf("%d", &n) != 1) return 0;
int cost[20][20], dist[20][20], next[20][20];
for (int i = 0; i < n; i++) {
for (int j = 0; j < n; j++) {
scanf("%d", &cost[i][j]);
dist[i][j] = cost[i][j];
if (i == j) {
next[i][j] = i;
} else if (cost[i][j] != INF) {
next[i][j] = j;
} else {
next[i][j] = -1;
}
}
}
int updated;
do {
updated = 0;
for (int i = 0; i < n; i++) {
for (int j = 0; j < n; j++) {
for (int k = 0; k < n; k++) {
if (cost[i][k] != INF && dist[k][j] != INF) {
if (dist[i][j] > cost[i][k] + dist[k][j]) {
dist[i][j] = cost[i][k] + dist[k][j];
next[i][j] = k;
updated = 1;
}
}
}
}
}
} while (updated);
for (int i = 0; i < n; i++) {
printf("For router %d ", i + 1);
for (int j = 0; j < n; j++) {
printf("node %d via %d Distance %d ", j + 1, next[i][j] + 1, dist[i][j]);
}
}
printf("\n");
return 0;
}
